# ── Server ──────────────────────────────────────────────
PORT=8787
APP_URL=http://localhost:5173          # waar de frontend draait (voor OAuth redirect terug)

# ── intervals.icu OAuth (aanvragen via https://intervals.icu/oauth/apply) ──
INTERVALS_CLIENT_ID=
INTERVALS_CLIENT_SECRET=
INTERVALS_REDIRECT_URI=http://localhost:8787/auth/intervals/callback

# ── intervals.icu API-key modus (voor snel testen zonder OAuth) ──
# Jouw persoonlijke key (Settings → Developer Settings). Als coach kun je hiermee
# ook athletes lezen/plannen die jou als coach hebben toegevoegd.
INTERVALS_API_KEY=
# Atleten die bij het opstarten automatisch gekoppeld worden (komma-gescheiden).
# 0 = jijzelf; i123456 = een atleet die jou als coach heeft toegevoegd.
INTERVALS_ATHLETE_IDS=0

# ── Claude API (AI-schema's). Leeg = ingebouwde regelgebaseerde generator ──
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Demo-atleten tonen naast echte koppelingen (true/false)
DEMO_ATHLETES=true

# Naam van de coach ("Bevestigd door …"). Leeg = "je coach".
COACH_NAME=

# ── Supabase: login en opslag. Leeg = geen login, opslag in data/db.json (alleen lokaal) ──
# Project in regio Frankfurt. URL en sleutels: Project Settings → API Keys.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Volledige toegang tot alle data: alleen hier, nooit in de frontend
SUPABASE_SECRET_KEY=
# Voor `npm run migrate`: Connect → Session pooler, met je databasewachtwoord
SUPABASE_DB_URL=
# AES-256-GCM-sleutel voor Intervals-tokens in de database (32 bytes, base64):
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Niet wijzigen na gebruik: dan zijn opgeslagen tokens onleesbaar.
TOKEN_ENCRYPTION_KEY=
# Wie admin is (komma-gescheiden). De server maakt deze accounts zelf aan.
ADMIN_EMAILS=
